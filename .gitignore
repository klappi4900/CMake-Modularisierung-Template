# Lokale, personenbezogene Claude-Code-Settings (Berechtigungen etc.)
.claude/settings.local.json

# Per FetchContent beim Konfigurieren heruntergeladene Dritt-Bibliotheken.
/third_party/nlohmann-json/
/third_party/googletest/
/third_party/sqlite3/

# Von add_log() angelegtes Log-Verzeichnis (Laufzeit-Artefakte).
/log/*

# Komplettes CMake-Build-Verzeichnis (Ninja-Dateien, .obj/.lib/.pdb, CMake-API-Cache,
# die von add_config() dorthin kopierte config.json). Alles reproduzierbar per
# `cmake -S . -B build -G Ninja` -- gehoert nicht ins Repository.
/build/
